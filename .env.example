# ── Telegram bot (required everywhere) ──────────────────────────────────────
BOT_TOKEN=123456789:AAA-your-bot-token-from-BotFather
# Optional: a private chat/channel ID that also receives every threat alert.
ADMIN_CHAT_ID=

# ── Local Telegram Bot API server (bot/ + telegram-bot-api/, docker-compose) ─
# Get these from https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
USE_LOCAL_BOT_API=true
TELEGRAM_LOCAL_API_URL=http://telegram-bot-api:8081

# ── VirusTotal ───────────────────────────────────────────────────────────────
VT_API_KEY=your-virustotal-api-key
VT_MALICIOUS_THRESHOLD=1
VT_SUSPICIOUS_THRESHOLD=1
VT_POLL_INTERVAL=3
VT_POLL_ATTEMPTS=10
# Files larger than this are never downloaded/scanned. Up to ~2000 with a
# local Bot API server; capped at 20 by api.telegram.org otherwise.
MAX_FILE_SIZE_MB=50

# ── Access control ───────────────────────────────────────────────────────────
# Comma-separated Telegram group IDs the bot is allowed to act in.
ALLOWED_GROUP_IDS=-1001234567890,-1009876543210
# Comma-separated Telegram user IDs allowed to view the Mini App dashboard.
WHITELIST_USER_IDS=111111111,222222222
# Optional: explicit user -> groups mapping for the dashboard, as JSON.
# {"111111111": [-1001234567890]}
GROUP_HANDLERS_JSON=
MAX_DASHBOARD_GROUPS=5

# ── Upstash Redis (shared between bot/ and the Vercel api/) ─────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── Mini App ─────────────────────────────────────────────────────────────────
# Public HTTPS URL of the deployed miniapp/ (Vercel deployment URL).
WEB_APP_URL=https://your-project.vercel.app

# ── Misc ─────────────────────────────────────────────────────────────────────
REPORT_TIMEZONE=Asia/Phnom_Penh
POLL_TIMEOUT=30
MAX_WORKERS=8

# ── VirusTotal throttle / retry / hybrid lookup ──────────────────────────────
# Free tier = 4 requests/min, 500/day. VT_MIN_INTERVAL_SECONDS spaces out every
# VT call so bursts from the worker pool never trip the 4/min limit.
VT_MIN_INTERVAL_SECONDS=15
VT_RETRY_ATTEMPTS=3
VT_RETRY_BASE_DELAY=5
# Hybrid URL lookup: read VT's last verdict before submitting a fresh scan.
URL_LOOKUP_ENABLED=true
URL_LOOKUP_MAX_AGE_SECONDS=1800

# ── Cache TTL split ──────────────────────────────────────────────────────────
URL_CACHE_TTL_SECONDS=3600
FILE_CACHE_TTL_SECONDS=86400

# ── Trust & reputation (per-user) ────────────────────────────────────────────
TRUST_SCORE_ENABLED=true
TRUST_NEW_ACCOUNT_DAYS=7
TRUST_NEW_MEMBER_DAYS=7
TRUST_NEW_MATCH_MODE=any        # any | all
TRUST_FLAGGED_STRIKES=3

# ── Link destination preview ─────────────────────────────────────────────────
LINK_PREVIEW_ENABLED=true
LINK_PREVIEW_TIMEOUT=8
LINK_PREVIEW_MAX_REDIRECTS=5

# ── New-member verification gate ─────────────────────────────────────────────
VERIFY_NEW_MEMBERS_DEFAULT=false
VERIFY_METHOD=button            # button | approve | age
VERIFY_AGE_DAYS=7
VERIFY_TIMEOUT_MINUTES=10

# ── Plans / quotas ───────────────────────────────────────────────────────────
SUPER_ADMIN_IDS=                # comma-separated; defaults to ADMIN_CHAT_ID if empty
PLAN_EXPIRY_DAYS=30
QUOTA_ENABLED=true

# ── Admin dashboard PIN authentication (Vercel API) ──────────────────────────
# Whitelisted admins set a 6-digit PIN on first login; afterwards they must
# enter it to unlock the dashboard. 3 fails = 5min lock, 5 = 1h, 10 = 24h + alert.
PIN_AUTH_ENABLED=true
PIN_SESSION_TTL_DAYS=30

# ── Payment (ABA PayWay — later self-serve) ──────────────────────────────────
PAYWAY_ENABLED=false
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_API_URL=https://checkout-sandbox.payway.com.kh
