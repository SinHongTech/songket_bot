{
  "version": 2,
  "builds": [
    {"src":"api/webhook.py","use":"@vercel/python","config":{"maxDuration":60}},
    {"src":"api/webapp.py","use":"@vercel/python","config":{"maxDuration":20}}
  ],
  "routes": [
    {"src":"/api/webhook","dest":"/api/webhook.py"},
    {"src":"/api/webapp","dest":"/api/webapp.py"},
    {"src":"^/$","dest":"/public/index.html"}
  ],
  "env":{"PYTHONUNBUFFERED":"1"}
}
