{
  "version": 2,
  "builds": [
    { "src": "api/dashboard.py", "use": "@vercel/python", "config": { "maxDuration": 20 } },
    { "src": "miniapp/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/dashboard", "dest": "/api/dashboard.py" },
    { "src": "/api/webapp", "dest": "/api/dashboard.py" },
    { "src": "/assets/(.*)", "dest": "/miniapp/assets/$1" },
    { "src": "^/$", "dest": "/miniapp/index.html" },
    { "src": "^/indexs.html$", "dest": "/miniapp/indexs.html" },
    { "src": "^/(app.js|style.css)$", "dest": "/miniapp/$1" },
    { "src": "/(.*)", "dest": "/miniapp/index.html" }
  ],
  "env": { "PYTHONUNBUFFERED": "1" }
}
